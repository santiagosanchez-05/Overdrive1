    - target: {fileID: 1556369742302046060, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: m_LocalEulerAnglesHint.z
      value: 0
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: lines.Array.size
      value: 5
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "As\xED que t\xFA eres el que anda vaciando las casas de los dealers...
        Llegas tarde, guapo. Esta la vigilo yo desde hace dos semanas."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Seis abajo, cuatro arriba. El malet\xEDn est\xE1 en el piso de arriba,
        al fondo del ala este."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "Cuando lo cojas avisar\xE1n a los de fuera y entrar\xE1n por la puerta
        del pasillo. No te quedes a mirar."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Yo no robo a cualquiera: solo a los que venden veneno en mi barrio.
        Parece que t\xFA tampoco."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[4]'
      value: "T\xFA pones los golpes, yo pongo las rutas. Lo que saquemos, a medias.
        Te espero fuera."
      objectReference: {fileID: 0}
    - target: {fileID: 3530597180747991227, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: m_Name
      value: Nina
      objectReference: {fileID: 0}
    m_RemovedComponents: []
    m_RemovedGameObjects: []
    m_AddedGameObjects: []
    m_AddedComponents:
    - targetCorrespondingSourceObject: {fileID: 7650821058121993669, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      insertIndex: -1
      addedObject: {fileID: 19011367}
