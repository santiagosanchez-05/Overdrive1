    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "Elysium. Aqu\xED cuenta el dinero el que da las \xF3rdenes en el barrio."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Ya entr\xE9 una vez a robarles y sal\xED por la ventana del ba\xF1o
        con las manos vac\xEDas. Esta vez no."
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: Los de la entrada llevan escopeta; dentro hay bates y navajas. Si te
        ven, corre hacia las esquinas.
      objectReference: {fileID: 0}
    - target: {fileID: 3340635082160553842, guid: eca1820b1548aef41804f53fa111d7c0, type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Encuentra la caja y sal. Yo te cubro desde aqu\xED... y esta vez la
        mitad es m\xEDa."
      objectReference: {fileID: 0}
